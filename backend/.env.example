# Example configuration. Copy to .env and replace every value with your own.
# Defaults used when a variable is missing are listed in backend/README.md.

# PostgreSQL
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# Signing key for login tokens: a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret

# HTTP port the API listens on
APP_PORT=8080

# Agenda documentation uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
